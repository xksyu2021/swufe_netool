{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "outDir": "./dist",
    "rootDir": "./src",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "types": ["node", "electron"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
