{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "outDir": "./dist",
    "rootDir": "./render",

    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,

    "sourceMap": true,
    "lib": ["ES2022", "DOM"]
  },
  "include": ["render/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
